[
  {
    "type": "vless",
    "name": "US Reality WS",
    "server": "us.example.com",
    "port": 443,
    "uuid": "MASKED_UUID",
    "flow": "xtls-rprx-vision",
    "tls": {
      "enabled": true,
      "server_name": "edge.example.com",
      "utls": { "enabled": true, "fingerprint": "chrome" },
      "reality": {
        "enabled": true,
        "public_key": "MASKED_PUBLIC_KEY",
        "short_id": "MASKED_SHORT_ID"
      }
    },
    "transport": {
      "type": "ws",
      "path": "/socket",
      "headers": { "Host": "cdn.example.com" }
    }
  },
  {
    "type": "hysteria2",
    "name": "JP Hysteria2",
    "server": "jp.example.com",
    "port": 443,
    "password": "MASKED_PASSWORD",
    "up_mbps": 20,
    "down_mbps": 80,
    "obfs": { "type": "salamander", "password": "MASKED_PASSWORD" },
    "tls": { "enabled": true, "server_name": "jp.example.com" }
  }
]
