{
  "name": "surgelab",
  "version": "1.4.0",
  "description": "SurgeLab - Local proxy configuration lab for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "jest",
    "pack": "electron-builder --dir",
    "build:win": "electron-builder --win --publish never"
  },
  "author": "SurgeLab Team",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "jest": "^29.0.0"
  },
  "build": {
    "appId": "com.surgelab.app",
    "productName": "SurgeLab",
    "win": {
      "target": ["nsis", "portable"]
    },
    "extraResources": [
      {
        "from": "sing-box.exe",
        "to": "sing-box.exe",
        "filter": ["**/*"]
      },
      {
        "from": "geoip.db",
        "to": "geoip.db",
        "filter": ["**/*"]
      },
      {
        "from": "geosite.db",
        "to": "geosite.db",
        "filter": ["**/*"]
      }
    ]
  }
}
